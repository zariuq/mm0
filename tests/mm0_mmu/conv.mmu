(sort wff provable)
(pub def id ((p wff ())) (wff ()) () p)
(pub theorem refl_thm ((p wff ())) ((h p)) p () (:conv p p h))
(pub theorem unfold_thm ((p wff ())) ((h p)) (id p) ()
  (:conv (id p) (:unfold id (p) () p) h))
(pub theorem trans_thm ((p wff ())) ((h (id p))) (id p) ()
  (:conv (id p) (:unfold id (p) () (:sym (:unfold id (p) () p))) h))
