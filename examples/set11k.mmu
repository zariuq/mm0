--| A triple syllogism inference. (Contributed by NM, 13-May-2004.)
(pub theorem syl3an ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()) (et wff ()) (ze wff ()))
  ((syl3an_1 (wi ph ps))
    (syl3an_2 (wi ch th))
    (syl3an_3 (wi ta et))
    (syl3an_4 (wi (w3a ps th et) ze)))
  (wi (w3a ph ch ta) ze)
  ()
  (syl ((w3a ph ch ta) (w3a ps th et) ze)
    (_3anim123i (ph ps ch th ta et)
      syl3an_1
      syl3an_2
      syl3an_3)
    syl3an_4))

--| A triple syllogism inference. (Contributed by NM, 15-Oct-2005.)
(pub theorem syl3anb ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()) (et wff ()) (ze wff ()))
