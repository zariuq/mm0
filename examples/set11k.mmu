    sylancl_1
    (a1i (ch ph)
      sylancl_2)
    sylancl_3))

--| Syllogism inference combined with modus ponens. (Contributed by Jeff Madsen, 2-Sep-2009.)
(pub theorem sylancr ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((sylancr_1 ps)
    (sylancr_2 (wi ph ch))
    (sylancr_3 (wi (wa ps ch) th)))
  (wi ph th)
