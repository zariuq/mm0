--| Distribution of implication over biconditional. Theorem *5.32 of [WhiteheadRussell] p. 125. (Contributed by NM, 1-Aug-1994.)
(pub theorem pm5_32 ((ph wff ()) (ps wff ()) (ch wff ()))
  ()
