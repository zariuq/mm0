--| Theorem *5.71 of [WhiteheadRussell] p. 125. (Contributed by Roy F. Longton, 23-Jun-2005.)
(pub theorem pm5_71 ((ph wff ()) (ps wff ()) (ch wff ()))
  ()
  (wi (wi ps (wn ch)) (wb (wa (wo ph ps) ch) (wa ph ch)))
  ()
