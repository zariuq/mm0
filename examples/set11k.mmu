    (syl3anb_2 (wb ch th))
    (syl3anb_3 (wb ta et))
    (syl3anb_4 (wi (w3a ps th et) ze)))
  (wi (w3a ph ch ta) ze)
  ()
  (sylbi ((w3a ph ch ta) (w3a ps th et) ze)
    (_3anbi123i (ph ps ch th ta et)
