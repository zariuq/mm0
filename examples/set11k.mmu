    (mpjao3dan_2 (wi (wa ph th) ch))
    (mpjao3dan_3 (wi (wa ph ta) ch))
    (mpjao3dan_4 (wi ph (w3o ps th ta))))
  (wi ph ch)
  ()
  (mpjaodan (ph (wo ps th) ch ta)
    (jaodan (ph ps ch th)
      mpjao3dan_1
      mpjao3dan_2)
    mpjao3dan_3
    (sylib (ph (w3o ps th ta) (wo (wo ps th) ta))
      mpjao3dan_4
      (df_3or (ps th ta)))))

