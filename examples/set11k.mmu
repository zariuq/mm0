    (sylanbrc_2 (wi ph ch))
    (sylanbrc_3 (wb th (wa ps ch))))
  (wi ph th)
  ()
  (sylibr (ph (wa ps ch) th)
    (jca (ph ps ch)
      sylanbrc_1
      sylanbrc_2)
