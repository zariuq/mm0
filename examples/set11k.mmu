--| Simplification of conjunction. (Contributed by Jeff Hankins, 17-Nov-2009.) (Proof shortened by Wolf Lammen, 23-Jun-2022.)
(pub theorem simpl1 ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ()
  (wi (wa (w3a ph ps ch) th) ph)
  ()
  (_3ad2antl1 (ph ps th ph ch)
    (simpl (ph th))))

