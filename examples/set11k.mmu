--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
(pub theorem exp5c ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()) (et wff ()))
  ((exp5c_1 (wi ph (wi (wa ps ch) (wi (wa th ta) et)))))
  (wi ph (wi ps (wi ch (wi th (wi ta et)))))
