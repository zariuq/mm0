--| Simplification of a conjunction. (Contributed by Mario Carneiro, 4-Jan-2017.) (Proof shortened by Wolf Lammen, 24-May-2022.)
(pub theorem simp_10l ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()) (et wff ()) (ze wff ()) (si wff ()) (rh wff ()) (mu wff ()) (la wff ()))
  ()
  (wi (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa ph ps) ch) th) ta) et) ze) si) rh) mu) la) ph)
