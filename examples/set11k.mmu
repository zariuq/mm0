--| Syllogism inference combined with contraction. (Contributed by NM, 16-Mar-2012.)
(pub theorem syl2anc ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((syl2anc_1 (wi ph ps))
    (syl2anc_2 (wi ph ch))
    (syl2anc_3 (wi (wa ps ch) th)))
  (wi ph th)
  ()
  (sylc (ph ps ch th)
    syl2anc_1
    syl2anc_2
    (ex (ps ch th)
      syl2anc_3)))

--| Double syllogism inference combined with contraction. (Contributed by BTernaryTau, 29-Sep-2023.)
(pub theorem syl2anc2 ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((syl2anc2_1 (wi ph ps))
    (syl2anc2_2 (wi ps ch))
    (syl2anc2_3 (wi (wa ps ch) th)))
  (wi ph th)
