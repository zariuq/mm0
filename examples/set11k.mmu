        (bicomd (ps ph (wa ph ps))
          (iba (ps ph))))
      (bicomd (ps ph (wa ph ps))
        (iba (ps ph))))))

--| Theorem *5.62 of [WhiteheadRussell] p. 125. (Contributed by Roy F. Longton, 21-Jun-2005.)
(pub theorem pm5_62 ((ph wff ()) (ps wff ()))
