    syl2anc2_1
    (syl (ph ps ch)
      syl2anc2_1
      syl2anc2_2)
    syl2anc2_3))

--| Syllogism inference combined with modus ponens. (Contributed by Jeff Madsen, 2-Sep-2009.)
(pub theorem sylancl ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((sylancl_1 (wi ph ps))
    (sylancl_2 ch)
    (sylancl_3 (wi (wa ps ch) th)))
  (wi ph th)
  ()
