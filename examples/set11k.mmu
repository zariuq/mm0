      syl3anb_2
      syl3anb_3)
    syl3anb_4))

--| A triple syllogism inference. (Contributed by NM, 29-Dec-2011.)
(pub theorem syl3anbr ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()) (et wff ()) (ze wff ()))
