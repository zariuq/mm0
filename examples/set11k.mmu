    (expd (ph (wa (wa ps ch) th) ta et)
      exp5j_1)))

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
(pub theorem exp5l ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()) (et wff ()))
