--| Disjunction of three antecedents (deduction). (Contributed by NM, 14-Oct-2005.)
(pub theorem _3jaod ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()) (ta wff ()))
  ((_3jaod_1 (wi ph (wi ps ch)))
    (_3jaod_2 (wi ph (wi th ch)))
    (_3jaod_3 (wi ph (wi ta ch))))
