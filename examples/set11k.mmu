--| A syllogism inference. (Contributed by NM, 21-Apr-1994.) (Proof shortened by Wolf Lammen, 22-Nov-2012.)
(pub theorem sylan ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((sylan_1 (wi ph ps))
    (sylan_2 (wi (wa ps ch) th)))
  (wi (wa ph ch) th)
