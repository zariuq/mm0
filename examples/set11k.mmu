--| Theorem *3.33 (Syll) of [WhiteheadRussell] p. 112. (Contributed by NM, 3-Jan-2005.)
(pub theorem pm3_33 ((ph wff ()) (ps wff ()) (ch wff ()))
  ()
  (wi (wa (wi ph ps) (wi ps ch)) (wi ph ch))
  ()
  (imp ((wi ph ps) (wi ps ch) (wi ph ch))
    (imim1 (ph ps ch))))

--| Theorem *3.34 (Syll) of [WhiteheadRussell] p. 112. (Contributed by NM, 3-Jan-2005.)
