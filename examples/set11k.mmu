--| Distribution of implication over biconditional (deduction form). (Contributed by NM, 25-Dec-2004.)
(pub theorem pm5_32rd ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((pm5_32d_1 (wi ph (wi ps (wb ch th)))))
