      (andi (ps ch th)))))

--| Theorem *5.17 of [WhiteheadRussell] p. 124. (Contributed by NM, 3-Jan-2005.) (Proof shortened by Wolf Lammen, 3-Jan-2013.)
(pub theorem pm5_17 ((ph wff ()) (ps wff ()))
  ()
  (wb (wa (wo ph ps) (wn (wa ph ps))) (wb ph (wn ps)))
  ()
  (_3bitrri ((wb ph (wn ps)) (wb (wn ps) ph) (wa (wi (wn ps) ph) (wi ph (wn ps))) (wa (wo ph ps) (wn (wa ph ps))))
    (bicom (ph (wn ps)))
    (dfbi2 ((wn ps) ph))
    (anbi12i ((wi (wn ps) ph) (wo ph ps) (wi ph (wn ps)) (wn (wa ph ps)))
      (bitr2i ((wo ph ps) (wo ps ph) (wi (wn ps) ph))
        (orcom (ph ps))
        (df_or (ps ph)))
      (imnan (ph ps)))))

--| Theorem *5.15 of [WhiteheadRussell] p. 124. (Contributed by NM, 3-Jan-2005.) (Proof shortened by Wolf Lammen, 15-Oct-2013.)
(pub theorem pm5_15 ((ph wff ()) (ps wff ()))
